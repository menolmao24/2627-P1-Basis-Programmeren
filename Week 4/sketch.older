let randomcolors
let ImportColors;


function setup() {
  createCanvas(800, 600);
 
}

function draw() {
  background(220);
  if (keyPressed() == true){
    fill(randomcolors)
  }
  rect(50,50,200,200)
}


function randomColor() {
  let randomcolors = random(["red", "green", "blue", "yellow"]);
  
}

function keyPressed() {
  if (keyIsPressed == true) 
    {
      keyActive = true;
    }
  }
  
  function keyReleased() {
    if (keyCode === 13) 
      {
        keyActive = false;
      }
    }